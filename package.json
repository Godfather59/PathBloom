{
  "name": "pathbloom-life-simulator",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:analyze": "ANALYZE=true vite build",
    "brand:assets": "node scripts/generate-icons.js",
    "screenshots": "node scripts/generate-screenshots.mjs",
    "test": "vitest run",
    "test:simulation": "vitest run src/logic/__tests__/simulation.test.js",
    "test:deep": "vitest run src/logic/__tests__/deepSimulation.test.js",
    "test:watch": "vitest",
    "simulate": "node scripts/run-life-simulations.mjs",
    "simulate:quick": "node scripts/run-life-simulations.mjs --lives 100",
    "simulate:deep": "node scripts/run-deep-simulation-checks.mjs --lives=100",
    "balance": "node scripts/run-life-simulations.mjs --lives 1000",
    "balance:deep": "node scripts/run-deep-simulation-checks.mjs --lives=1000",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "puppeteer": "^25.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "rollup-plugin-visualizer": "^7.0.1",
    "vite": "^7.2.4",
    "vitest": "^4.1.10"
  }
}
