      "conditions": { "minAge": 8, "maxAge": 30 },
      "text": { "en": "One of your parents lost their job and the household budget is under pressure.", "ar": "فقد أحد والديك عمله وأصبحت ميزانية الأسرة تحت ضغط." },
      "choices": [
