        { "id": "emotional", "text": { "en": "Offer emotional support", "ar": "قدم دعما معنويا" }, "outcome": { "en": "You listened and helped everyone stay calm.", "ar": "استمعت للجميع وساعدتهم على الهدوء." }, "effects": { "stress": 2 }, "reputation": { "family": 4, "trust": 3 }, "next": { "eventId": "family_parent_job_result", "delayMonths": 8 } },
        { "id": "distance", "text": { "en": "Keep your distance", "ar": "ابتعد عن المشكلة" }, "outcome": { "en": "Your family felt that you were absent during a difficult time.", "ar": "شعرت عائلتك أنك غبت في وقت صعب." }, "effects": { "stress": -2, "happiness": -2 }, "reputation": { "family": -5, "trust": -4 }, "next": { "eventId": "family_parent_job_result", "delayMonths": 8 } }
      ]
